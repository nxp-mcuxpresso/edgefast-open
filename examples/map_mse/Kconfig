mainmenu "Bluetooth: MAP MSE"

config BT_MAP_MSE_DISCOVER_RESULT_COUNT
	int "Maximum result count per device discovery"
	default 10

config BT_MAP_MSE_MAS_INSTANCE_ID
	hex "MSE MAS instance ID"
	default 0

config BT_MAP_MSE_SUPPORTED_FEATURES
	hex "MSE supported features"
	default 0x007FFFFF

config BT_MAP_MSE_SUPPORTED_MSG_TYPES
	hex "MSE supported message types"
	default 0x1F

config BT_MAP_MSE_MAS_DATA_BUF_SIZE
	int "MSE MAS data buffer size (bytes)"
	default BT_GOEP_RFCOMM_MTU

config BT_MAP_MSE_MAS_DATA_BUF_COUNT
	int "MSE MAS data buffer count"
	default 1

config BT_MAP_MSE_MNS_DATA_BUF_SIZE
	int "MSE MNS data buffer size (bytes)"
	default BT_GOEP_RFCOMM_MTU

config BT_MAP_MSE_MNS_DATA_BUF_COUNT
	int "MSE MNS data buffer count"
	default 1

config BT_MAP_MSE_MAS_MSGQ_COUNT
	int "MSE MAS message queue count"
	default 3

config BT_MAP_MSE_MNS_MSGQ_COUNT
	int "MSE MNS message queue count"
	default 2

config BT_MAP_MSE_PATH_MAX_LEN
	int "Maximum path length"
	default 45
	range 45 65535
	help
	  The minimal value is 45 to accommodate
	  the longest path(0:/root/telecom/msg/deleted/) and message handle.

config BT_MAP_MSE_NAME_MAX_LEN
	int "Maximum name length"
	default 17
	range 17 255
	help
	  The minimal value is 17 to accommodate the longest message handle.

source "middleware/edgefast_open/Kconfig"
source "Kconfig.mcuxpresso"
