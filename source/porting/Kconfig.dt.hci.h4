config DT_HAS_ZEPHYR_BT_HCI_UART_ENABLED
	bool
	help
	  No prefix in generated macro

config DT_HAS_NXP_BT_HCI_UART_ENABLED
	bool
	select DT_HAS_ZEPHYR_BT_HCI_UART_ENABLED
	select DT_CHOSEN_zephyr_bt_hci_EXISTS
	help
	  No prefix in generated macro

if DT_HAS_NXP_BT_HCI_UART_ENABLED

config DT_N_INST_0_hci_uart_P_instance
	int "UART instance"
	default 2 if MCUX_HW_DEVICE_MIMXRT1176
	default 0
	help
	  No prefix in generated macro

config DT_N_INST_0_hci_uart_P_current_speed
	int "UART Current Speed"
	default 3000000 if MCUX_COMPONENT_component.wifi_bt_module.board_aw_am510_arduino
	default 115200
	help
	  Configure the default UART communication speed for Bluetooth HCI UART interface.
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_primary_speed
	int "UART Primary Download Speed for firmware downloading"
	default 115200
	help
	  Configure the default UART communication speed for firmware downloading during the
	  primary stage.
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_primary_speed_EXISTS
	bool
	default y
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_secondary_speed
	int "UART Secondary Download Speed for firmware downloading"
	default 3000000
	help
	  Configure the default UART communication speed for firmware downloading during the
	  secondary stage.
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_secondary_speed_EXISTS
	bool
	default y
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_hci_operation_speed
	int "UART HCI Operation Speed"
	default 3000000
	help
	  Configure the default UART communication speed for HCI operation.
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_hci_operation_speed_EXISTS
	bool
	default y
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_hw_flow_control
	bool "UART Hardware Flow Control"
	default y
	help
	  Enable UART Hardware Flow Control for Bluetooth HCI UART interface.
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_hw_flow_control_EXISTS
	bool
	default y if DT_N_INST_0_nxp_bt_hci_uart_P_hw_flow_control
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_primary_flowcontrol
	bool "UART Primary Download Flow Control for firmware downloading"
	help
	  Configure the flow control settings for firmware downloading during the primary stage.
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_primary_flowcontrol_EXISTS
	bool
	default y if DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_primary_flowcontrol
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_secondary_flowcontrol
	bool "UART Secondary Download Flow Control for firmware downloading"
	default y
	help
	  Configure the flow control settings for firmware downloading during the secondary stage.
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_secondary_flowcontrol_EXISTS
	bool
	default y if DT_N_INST_0_nxp_bt_hci_uart_P_fw_download_secondary_flowcontrol
	help
	  No prefix in generated macro

# sdio_reset_gpios
config DT_N_INST_0_nxp_bt_hci_uart_P_sdio_reset_gpios_EXISTS
	bool "SDIO reset GPIO"
	default n if MCUX_COMPONENT_component.wifi_bt_module.board_aw_am510_arduino
	default y
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_sdio_reset_gpios_IDX_0_VAL_port
	int "SDIO reset GPIO port"
	default 3 if MCUX_HW_DEVICE_MCXN547
	default 3 if MCUX_HW_BOARD_mcxn9xxevk
	default 1 if MCUX_HW_BOARD_frdmmcxn947
	default 3 if MCUX_HW_DEVICE_MIMXRT1042
	default 1 if MCUX_HW_DEVICE_MIMXRT1052
	default 1 if MCUX_HW_DEVICE_MIMXRT1062
	default 9 if MCUX_HW_DEVICE_MIMXRT1176
	default 4 if MCUX_HW_DEVICE_MIMXRT1187 || MCUX_HW_DEVICE_MIMXRT1189
	default 2 if MCUX_HW_DEVICE_MIMXRT595S
	default 2 if MCUX_HW_DEVICE_MIMXRT685S
	default 7 if MCUX_HW_DEVICE_MIMXRT798S
	default 0
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_sdio_reset_gpios_IDX_0_VAL_pin
	int "SDIO reset GPIO pin"
	default 5 if MCUX_HW_DEVICE_MCXN547
	default 5 if MCUX_HW_BOARD_mcxn9xxevk
	default 22 if MCUX_HW_BOARD_frdmmcxn947
	default 4 if MCUX_HW_DEVICE_MIMXRT1042
	default 19 if MCUX_HW_DEVICE_MIMXRT1052
	default 24 if MCUX_HW_DEVICE_MIMXRT1062
	default 15 if MCUX_HW_DEVICE_MIMXRT1176
	default 7 if MCUX_HW_DEVICE_MIMXRT1187 || MCUX_HW_DEVICE_MIMXRT1189
	default 10 if MCUX_HW_DEVICE_MIMXRT595S
	default 10 if MCUX_HW_DEVICE_MIMXRT685S
	default 23 if MCUX_HW_DEVICE_MIMXRT798S
	default 0
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_sdio_reset_gpios_IDX_0_VAL_flags
	int "SDIO reset GPIO flags"
	default 1 if MCUX_HW_DEVICE_MCXN547
	default 1 if MCUX_HW_BOARD_mcxn9xxevk
	default 1 if MCUX_HW_BOARD_frdmmcxn947
	default 1 if MCUX_HW_DEVICE_MIMXRT1042
	default 1 if MCUX_HW_DEVICE_MIMXRT1052
	default 1 if MCUX_HW_DEVICE_MIMXRT1062
	default 1 if MCUX_HW_DEVICE_MIMXRT1176
	default 1 if MCUX_HW_DEVICE_MIMXRT1187 || MCUX_HW_DEVICE_MIMXRT1189
	default 1 if MCUX_HW_DEVICE_MIMXRT595S
	default 1 if MCUX_HW_DEVICE_MIMXRT685S
	default 1 if MCUX_HW_DEVICE_MIMXRT798S
	default 1
	help
	  No prefix in generated macro

# w_disable_gpios
config DT_N_INST_0_nxp_bt_hci_uart_P_w_disable_gpios_EXISTS
	bool "WIFI disable GPIO"
	default y
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_w_disable_gpios_IDX_0_VAL_port
	int "WIFI disable GPIO port"
	default 0 if MCUX_HW_DEVICE_MCXN547
	default 0 if MCUX_HW_BOARD_mcxn9xxevk
	default 1 if MCUX_HW_BOARD_frdmmcxn947
	default 3 if MCUX_HW_DEVICE_MIMXRT1042
	default 1 if MCUX_HW_DEVICE_MIMXRT1052
	default 1 if MCUX_HW_DEVICE_MIMXRT1062
	default 9 if MCUX_HW_DEVICE_MIMXRT1176
	default 4 if MCUX_HW_DEVICE_MIMXRT1187 || MCUX_HW_DEVICE_MIMXRT1189
	default 0 if MCUX_HW_DEVICE_MIMXRT595S
	default 0 if MCUX_HW_DEVICE_MIMXRT685S
	default 3 if MCUX_HW_DEVICE_MIMXRT798S
	default 0
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_w_disable_gpios_IDX_0_VAL_pin
	int "WIFI disable GPIO pin"
	default 8 if MCUX_HW_DEVICE_MCXN547
	default 8 if MCUX_HW_BOARD_mcxn9xxevk
	default 21 if MCUX_HW_BOARD_frdmmcxn947
	default 2 if MCUX_HW_DEVICE_MIMXRT1042
	default 26 if MCUX_HW_DEVICE_MIMXRT1052
	default 19 if MCUX_HW_DEVICE_MIMXRT1062
	default 31 if MCUX_HW_DEVICE_MIMXRT595S
	default 12 if MCUX_HW_DEVICE_MIMXRT685S
	default 7 if MCUX_HW_DEVICE_MIMXRT798S
	default 30 if MCUX_HW_DEVICE_MIMXRT1176
	default 17 if MCUX_HW_DEVICE_MIMXRT1187 || MCUX_HW_DEVICE_MIMXRT1189
	default 0
	help
	  No prefix in generated macro

config DT_N_INST_0_nxp_bt_hci_uart_P_w_disable_gpios_IDX_0_VAL_flags
	int "WIFI disable GPIO flags"
	default 1 if MCUX_HW_DEVICE_MCXN547
	default 1 if MCUX_HW_BOARD_mcxn9xxevk
	default 1 if MCUX_HW_BOARD_frdmmcxn947
	default 1 if MCUX_HW_DEVICE_MIMXRT1042
	default 1 if MCUX_HW_DEVICE_MIMXRT1052
	default 1 if MCUX_HW_DEVICE_MIMXRT1062
	default 1 if MCUX_HW_DEVICE_MIMXRT595S
	default 1 if MCUX_HW_DEVICE_MIMXRT685S
	default 1 if MCUX_HW_DEVICE_MIMXRT798S
	default 1 if MCUX_HW_DEVICE_MIMXRT1176
	default 1 if MCUX_HW_DEVICE_MIMXRT1187 || MCUX_HW_DEVICE_MIMXRT1189
	default 1
	help
	  No prefix in generated macro

endif # DT_HAS_NXP_BT_HCI_UART_ENABLED