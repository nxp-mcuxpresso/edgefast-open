# low power component
config MCUX_COMPONENT_middleware.edgefast_open.low_power
    bool "Low power"
    depends on MCUX_HW_DEVICE_MIMXRT595S || MCUX_HW_DEVICE_RW612 || MCUX_HW_DEVICE_RW610
    select MCUX_COMPONENT_middleware.edgefast_open.host_low_power

config MCUX_COMPONENT_middleware.edgefast_open.host_low_power
    bool
    select MCUX_COMPONENT_middleware.wireless.framework
    select MCUX_COMPONENT_middleware.wireless.framework.lowpower

config MCUX_COMPONENT_middleware.edgefast_open.controller_low_power
    bool
    default y if MCUX_COMPONENT_middleware.edgefast_open.low_power && !MCUX_HW_DEVICE_RW612 && !MCUX_HW_DEVICE_RW610
