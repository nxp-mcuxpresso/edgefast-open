config PORT_SHELL
	bool
	select MCUX_COMPONENT_component.lists
	select MCUX_COMPONENT_component.common_task

if PORT_SHELL
config SHELL_ADVANCE
	bool "Enable Advanced Shell Features"
	default y
	help
	  Enable advanced shell features for enhanced command-line interaction
	  and extended functionality in the EdgeFast shell environment.
	  No prefix in generated macro

config SHELL_USE_COMMON_TASK
	bool "Shell Common Task Configuration"
	default n
	help
	  Configure the common task usage for shell operations.
	  No prefix in generated macro

config SHELL_PROMPT
	string "Shell prompt"
	default SHELL_PROMPT_UART
	help
	  Configure the prompt string for shell operations.
	  Macro value is in quotes

config SHELL_PROMPT_UART
	string
	default "uart:~$ "
	help
	  Configure the prompt UART string for shell operations.
	  Macro value is in quotes

config SHELL_BUFFER_SIZE
	int "Shell Command Buffer Size Configuration"
	range 8 65535
	default 64
	help
	  Configure the buffer size for shell cmd.
	  No prefix in generated macro

config SHELL_ECHO_WHEN_EOF_RECEIVED
	bool "Shell Command only be echoed when an EOF is received"
	default n
	help
	  Shell Command only be echoed when an EOF is received.
	  No prefix in generated macro

config SHELL_AUTO_FLUSH
	bool "Auto flush all print message"
	default n
	help
	  Auto flush all print message.
	  No prefix in generated macro

config SHELL_GETOPT
	bool "Threadsafe getopt support in shell"
	select GETOPT
	help
	  This config creates a separate getopt_state for the shell instance.
	  It ensures that using getopt with shell is thread safe.
	  When more threads are using sys_getopt please call sys_getopt_state_get to
	  get getopt state of the shell thread.

endif # PORT_SHELL