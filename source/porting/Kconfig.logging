config LOG
	bool "Bluetooth LOG Configuration"
	default n
	help
	  Enable LOG features for Bluetooth stack

config BT_LOGGING
	bool "Bluetooth Debug Configuration"
	default BT_LOG
	help
	  Enable debug features and logging for Bluetooth stack

config BT_LOGGING_ASYNC
	bool "Bluetooth Logging ASYNC Mode"
	depends on BT_LOGGING
	default y
	help
	  Configure Bluetooth logging async mode

config BT_LOGGING_INIT_PRIORITY
	int "Bluetooth Logging Initialization Priority"
	depends on BT_LOGGING
	default 50
	range 0 255
	help
	  Configure Bluetooth logging initialization priority

config BT_DEFAULT_LOG_LEVEL
	int "Bluetooth Default Log Level"
	depends on BT_LOGGING
	default 4
	range 0 6
	help
	  Configure logging verbosity for Bluetooth stack initialization and core configuration
