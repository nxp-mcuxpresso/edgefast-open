menuconfig MCUX_COMPONENT_middleware.edgefast_open.hci
	bool "Edgeafast Open Bluetooth HCI Configuration"
	default y
	help
	  The HCI (Host Controller Interface) configuration for Edgefast Open Bluetooth stack

if MCUX_COMPONENT_middleware.edgefast_open.hci

rsource "./*/Kconfig"

choice MCUX_COMPONENT_middleware.edgefast_open.hci.transport
	prompt "Bluetooth HCI Transport Method"
	default MCUX_COMPONENT_middleware.edgefast_open.hci.transport.platform if MCUX_HW_DEVICE_RW612
	default MCUX_COMPONENT_middleware.edgefast_open.hci.transport.h4
	help
	  Select the transport method for Bluetooth Host Controller Interface

config MCUX_COMPONENT_middleware.edgefast_open.hci.transport.h4
	bool "H4 UART Transport"
	depends on MCUX_HW_DEVICE_MIMXRT1042 || MCUX_HW_DEVICE_MIMXRT1062 || \
		MCUX_HW_DEVICE_MIMXRT685S || MCUX_HW_DEVICE_MIMXRT1176 || \
		MCUX_HW_DEVICE_MIMXRT595S || MCUX_HW_DEVICE_MIMXRT1052 || \
		MCUX_HW_DEVICE_MIMXRT1189 || MCUX_HW_DEVICE_MIMXRT1187 || \
		MCUX_HW_DEVICE_MIMXRT1166 || MCUX_HW_DEVICE_MCXN547 || \
		MCUX_HW_DEVICE_MCXN947    || MCUX_HW_DEVICE_MIMXRT798S
	select DT_HAS_NXP_BT_HCI_UART_ENABLED
	select MCUX_COMPONENT_component.serial_manager
	select MCUX_COMPONENT_component.serial_manager_uart
	select MCUX_COMPONENT_driver.lpuart_edma if MCUX_HAS_COMPONENT_driver.lpuart_edma
	select MCUX_COMPONENT_driver.lpflexcomm_lpuart_edma if MCUX_HAS_COMPONENT_driver.lpflexcomm_lpuart_edma
	select MCUX_COMPONENT_driver.flexcomm_usart_dma if MCUX_HAS_COMPONENT_driver.flexcomm_usart_dma
	select MCUX_COMPONENT_component.igpio_adapter if MCUX_HAS_COMPONENT_driver.igpio
	select MCUX_COMPONENT_component.rt_gpio_adapter if MCUX_HAS_COMPONENT_driver.lpc_gpio
	select MCUX_COMPONENT_component.rgpio_adapter if MCUX_HAS_COMPONENT_driver.rgpio
	select MCUX_COMPONENT_component.gpio_adapter if MCUX_HAS_COMPONENT_driver.gpio
	select MCUX_COMPONENT_middleware.wifi.fwdnld
	select MCUX_COMPONENT_middleware.wifi.osa_free_rtos
	select MCUX_COMPONENT_middleware.sdmmc.host.usdhc
	select MCUX_COMPONENT_middleware.sdmmc.sdio
	select MCUX_COMPONENT_middleware.edgefast_open.controller.lwip.config if !MCUX_COMPONENT_middleware.lwip
	select MCUX_COMPONENT_middleware.edgefast_open.controller.wifi.config if !MCUX_COMPONENT_middleware.wifi
	select BT_IND_DNLD if !BT_BYPASS_DOWNLOAD
	select BT_ONLY_DNLD if !BT_BYPASS_DOWNLOAD

config MCUX_COMPONENT_middleware.edgefast_open.hci.transport.platform
	bool "Platform Transport"
	depends on MCUX_HW_DEVICE_RW612

endchoice # MCUX_COMPONENT_middleware.edgefast_open.hci.transport

config BT_IND_DNLD
	bool "Bluetooth Independent Firmware Download (Bluetooth Firmware Only)"
	default n

config BT_ONLY_DNLD
	bool "Bluetooth Independent Firmware Download (Bluetooth Firmware Only)"
	default n

config BT_BYPASS_DOWNLOAD
	bool "Bypass Bluetooth Firmware Download"
	default n

