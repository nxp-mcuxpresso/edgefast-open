config BT_CRYPTO
	bool
	select MBEDTLS if !BUILD_WITH_TFM
	select MBEDTLS_PSA_CRYPTO_C if !BUILD_WITH_TFM
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_ALG_CMAC
	select PSA_WANT_ALG_ECB_NO_PADDING
	imply MBEDTLS_AES_ROM_TABLES if MBEDTLS_PSA_CRYPTO_C
	help
	  This option enables the Bluetooth Cryptographic Toolbox.

config PSA_CRYPTO
	bool "PSA Crypto Support"
	help
	  Enable support for PSA (Platform Security Architecture) Crypto

config BT_CRYPTO_PSA
	bool "PSA Crypto Support for Bluetooth"
	depends on BT_CRYPTO
	help
	  This option enables PSA Crypto API support for Bluetooth cryptographic operations.

config PSA_CRYPTO_CLIENT
	bool
	default y
	help
	  Enable support for PSA (Platform Security Architecture) Crypto Client
