config BT_RX_STACK_SIZE
	default 4096
	range 4096 65536

config EDGEFAST_OPEN_NO_UNALIGNED_ACCESS
	default y if MCUX_HW_DEVICE_RW612

if BT_LONG_WQ
config BT_LONG_WQ_STACK_SIZE
	default 4096 if MCUX_HW_DEVICE_MCXN547
	default 4096 if MCUX_HW_DEVICE_MCXN947
	default 4096 if MCUX_HW_DEVICE_MCXN947T
	default 4096 if MCUX_HW_DEVICE_RW612
	default 3072

config BT_LONG_WQ_PRIO
	range 0 NUM_PREEMPT_PRIORITIES

endif # BT_LONG_WQ

config SYSTEM_WORKQUEUE_PRIORITY
	range 0 NUM_PREEMPT_PRIORITIES

config BT_RX_PRIO
	range 0 NUM_PREEMPT_PRIORITIES
	default 9

config BT_HCI_TX_PRIO
	range 0 NUM_PREEMPT_PRIORITIES

config BT_CONN_TX_NOTIFY_WQ_PRIO
	range 0 NUM_PREEMPT_PRIORITIES

config BT_DRIVER_RX_HIGH_PRIO
	range 0 NUM_PREEMPT_PRIORITIES

